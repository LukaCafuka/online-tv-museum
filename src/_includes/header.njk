<header class="site-header">
  <div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>
  <h1><a href="{% if lang == 'hr' %}/hr/{% else %}/{% endif %}">{{ site.t[lang].siteTitle }}</a></h1>
  <button type="button" id="hamburger" class="hamburger" aria-label="Open menu" aria-expanded="false">
    <span class="hamburger-bar"></span>
    <span class="hamburger-bar"></span>
    <span class="hamburger-bar"></span>
  </button>
  <div class="header-right" id="header-menu">
    <nav class="header-nav">
      <a href="{% if lang == 'hr' %}/hr/{% else %}/{% endif %}">{{ site.t[lang].home }}</a>
      <a href="{% if lang == 'hr' %}/hr/galerije/{% else %}/galleries/{% endif %}">{{ site.t[lang].galleries }}</a>
      <a href="https://z.com.hr" target="_blank" rel="noopener noreferrer">{{ site.t[lang].contact }}</a>
    </nav>
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
      <span class="theme-icon-light">&#9790;</span>
      <span class="theme-icon-dark">&#9788;</span>
    </button>
    <div class="lang-switch">
      {% if lang == 'en' %}
        <span>EN</span> | <a href="/hr/" onclick="try{localStorage.setItem('lang','hr')}catch(e){}">HR</a>
      {% else %}
        <a href="/" onclick="try{localStorage.setItem('lang','en')}catch(e){}">EN</a> | <span>HR</span>
      {% endif %}
    </div>
  </div>
</header>
